# ---------------------------------------------------------------------------
# NOTE: data/ and results/ are anchored with a leading slash so they only match
# the top-level directories. Without the slash, `data/` also matched src/data/,
# which silently excluded the entire preprocessing package from the repository.
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
.env

# Data and results (top-level only)
/data
/results
/results-scratch

# Model artefacts
*.pth
*.pt
*.ckpt

# Cluster logs
*.log
slurm-*.out
slurm-*.err

# OS
.DS_Store

# Bulk TCGA per-series metadata (regenerable via src/data/tcga/download_full.py)
metadata/tcga/*.csv
!metadata/tcga/downloaded.csv
!metadata/tcga/downloaded_series.csv
